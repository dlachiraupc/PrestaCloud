# ============================================================
# PrestaCloud — Apache (raíz web = esta carpeta public/)
# Compatible con cPanel / hosting compartido. El deploy conserva el bloque de PHP que agrega cPanel.
# ============================================================
Options -Indexes

# ─── Seguridad: bloquear archivos sensibles ───────────────
<FilesMatch "\.(env|sql|sql\.gz|log|sh|bak|pfx|p12|pem|key|json|lock|md|yml|yaml|dist)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Siempre por HTTPS (en local, localhost queda en http)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTP_HOST} !^(localhost|127.0.0.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Archivos reales (salud.php, estáticos) se sirven tal cual
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Todo lo demás → un único punto de entrada
    RewriteRule ^ index.php [L]
</IfModule>

# ─── Headers de seguridad ────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options  "nosniff"
    Header always set X-Frame-Options         "SAMEORIGIN"
    Header always set Referrer-Policy         "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json
</IfModule>
