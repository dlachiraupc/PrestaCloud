<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="false"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="Unitarias"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Paridad con el v13"><directory>tests/Paridad</directory></testsuite>
        <testsuite name="Integracion"><directory>tests/Integracion</directory></testsuite>
    </testsuites>
    <source><include><directory>src</directory></include></source>
</phpunit>
