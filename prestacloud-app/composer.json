{
    "name": "empresascloud/prestacloud",
    "description": "PrestaCloud: gestión de préstamos y cobranza (servicio de EmpresasCloud)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "PrestaCloud\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "PrestaCloud\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit --colors=never"
    },
    "config": { "sort-packages": true, "optimize-autoloader": true }
}
